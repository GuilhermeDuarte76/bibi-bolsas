# Configuracao da Bibi Bolsas Front-end
# Copie para `.env` e ajuste conforme o ambiente.

# URL base da API .NET (sem barra no final).
# Local: http://127.0.0.1:5080
# Producao: https://api.bibibolsas.com
VITE_API_URL=http://127.0.0.1:5080
# Alternativa aceita pelo codigo:
# VITE_API_BASE_URL=http://127.0.0.1:5080
VITE_API_BASE_PATH=/api

# Use dados mockados? Sem URL de API, o padrao e `true`.
# Com URL de API configurada, o padrao passa a ser `false`.
VITE_USE_MOCK=true

# ---------------------------------------------------------------------------
# Tracking e Ads (todos opcionais)
#
# Para a configuracao mais simples, preencha GA4 + Google Ads + Meta Pixel.
# Use GTM somente se as tags forem administradas por um container; nao ative
# no GTM a mesma tag preenchida diretamente abaixo, para nao duplicar eventos.
# Guia completo: docs/tracking.md

# Google Tag Manager (GTM-XXXXXXX)
VITE_GTM_ID=

# Google Analytics 4 (G-XXXXXXXXXX)
VITE_GA4_ID=

# Google Ads: ID AW-XXXXXXXXX e rotulo da conversao de compra
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_PURCHASE_LABEL=

# Meta Pixel / Dataset ID (somente numeros)
VITE_META_PIXEL_ID=

# Mostra os eventos no console e ativa o DebugView do GA4 em desenvolvimento.
VITE_ANALYTICS_DEBUG=false
